{
  "name": "@kedrzu/gmail-mcp",
  "version": "0.1.0",
  "description": "Multi-account Gmail MCP server for agents: search, read, Markdown drafts with attachments, label rules — configured per project, no sending",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gmail-mcp": "src/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "start": "bun src/main.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@googleapis/gmail": "^22.0.1",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "email-forward-parser": "^1.7.2",
    "email-reply-parser": "^2.3.5",
    "google-auth-library": "^11.1.0",
    "marked": "^18.0.14",
    "nodemailer": "^10.0.12",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.0"
  }
}
